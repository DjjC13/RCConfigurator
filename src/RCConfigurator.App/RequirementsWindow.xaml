<Window x:Class="RCConfigurator.App.RequirementsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RCConfigurator" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24">
        <TextBlock Text="Two things to set up first" FontSize="20" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,20"
                   Text="RCConfigurator changes your right-click menus through Nilesoft Shell, and those changes show in the classic Windows menu. It opens once both of these are in place." />

        <Border Padding="16" CornerRadius="6" BorderThickness="1" BorderBrush="#50808080">
            <DockPanel>
                <TextBlock x:Name="EngineMark" DockPanel.Dock="Left" FontSize="20" Width="34" VerticalAlignment="Center" />
                <Button x:Name="EngineButton" DockPanel.Dock="Right" Content="Install…" Click="OnInstallEngine"
                        VerticalAlignment="Center" Padding="16,6" Margin="16,0,0,0" />
                <StackPanel>
                    <TextBlock Text="Nilesoft Shell" FontWeight="SemiBold" />
                    <TextBlock x:Name="EngineText" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Padding="16" CornerRadius="6" BorderThickness="1" BorderBrush="#50808080" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock x:Name="ClassicMark" DockPanel.Dock="Left" FontSize="20" Width="34" VerticalAlignment="Center" />
                <Button x:Name="ClassicButton" DockPanel.Dock="Right" Content="Switch to it" Click="OnUseClassicMenu"
                        VerticalAlignment="Center" Padding="16,6" Margin="16,0,0,0" />
                <StackPanel>
                    <TextBlock Text="Classic right-click menu" FontWeight="SemiBold" />
                    <TextBlock x:Name="ClassicText" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,16,0,0" MinHeight="20" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ContinueButton" Content="Continue" Click="OnContinue" IsDefault="True" Padding="20,6" />
            <Button Content="Quit" IsCancel="True" Padding="16,6" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
