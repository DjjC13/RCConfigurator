<Window x:Class="RCConfigurator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RCConfigurator" Width="1300" Height="820" MinWidth="1080" MinHeight="660"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- A panel with a faint fill and outline, which sets each part of the window apart. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="CompactRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <!-- An icon from the font Windows uses for its own interface. -->
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title and commands -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel HorizontalAlignment="Left">
                <TextBlock Text="Right-click menus" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding EngineStatus}" Style="{StaticResource Secondary}" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding RefreshCommand}" Padding="12,6" Margin="0,0,8,0" ToolTip="Read the menu from Windows again">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ManageGroupsCommand}" Padding="12,6" Margin="0,0,8,0" ToolTip="Create groups of file types to edit together">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8EC;" />
                        <TextBlock Text="File type groups…" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding CleanupCommand}" Padding="12,6" ToolTip="Remove entries left in the registry by programs that are no longer installed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xEA99;" />
                        <TextBlock Text="Registry clean-up…" />
                    </StackPanel>
                </Button>

                <Border Width="1" Margin="16,4" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <Button Content="Disable rules" Command="{Binding DisconnectCommand}" Padding="12,6" Margin="0,0,8,0"
                        ToolTip="Return Nilesoft Shell to its own settings and restart Explorer"
                        Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                <Button Command="{Binding ApplyCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="16,6" ToolTip="{Binding ApplyHint}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8FB;" />
                        <TextBlock Text="Apply to Explorer" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Shown when programs that are gone have left entries in the registry -->
        <Border Grid.Row="1" Margin="0,0,0,16" Padding="14,10" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Visibility="{Binding HasLeftoverNotice, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding DismissLeftoversCommand}" Padding="8,6" Margin="8,0,0,0"
                        ToolTip="Hide this until the app is next opened" AutomationProperties.Name="Dismiss">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" Margin="0" FontSize="12" />
                </Button>
                <Button DockPanel.Dock="Right" Content="Ignore" Command="{Binding IgnoreLeftoversCommand}" Padding="12,6" Margin="8,0,0,0"
                        ToolTip="Do not mention these programs again" />
                <Button DockPanel.Dock="Right" Content="Review…" Command="{Binding CleanupCommand}" Padding="12,6" Margin="16,0,0,0" />
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE7BA;" FontSize="16" Margin="0,0,12,0"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                <TextBlock Text="{Binding LeftoverNotice}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- What was right-clicked, and the user's own items -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Target" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="When I right-click" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="Label" />

                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsFileTarget, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="File type" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding FileChoices}" SelectedItem="{Binding SelectedFileChoice}" DisplayMemberPath="Label" Margin="0,0,0,6"
                                      Visibility="{Binding ShowFileChoices, Converter={StaticResource BoolToVisibility}}" />
                            <ComboBox IsEditable="True" ItemsSource="{Binding ExtensionPresets}"
                                      Text="{Binding Extension, UpdateSourceTrigger=PropertyChanged}"
                                      Visibility="{Binding ShowExtension, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <CheckBox Content="Include Shift-only items" IsChecked="{Binding IncludeShiftItems}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Custom items" Style="{StaticResource SectionTitle}" />
                        <UniformGrid DockPanel.Dock="Bottom" Rows="1" Margin="0,8,0,0">
                            <Button Content="Add…" Command="{Binding AddItemCommand}" Margin="0,0,4,0" HorizontalAlignment="Stretch" />
                            <Button Content="Edit…" Command="{Binding EditItemCommand}" Margin="2,0" HorizontalAlignment="Stretch" />
                            <Button Content="Remove" Command="{Binding RemoveItemCommand}" Margin="4,0,0,0" HorizontalAlignment="Stretch" />
                        </UniformGrid>
                        <ListBox ItemsSource="{Binding NewItems}" SelectedItem="{Binding SelectedNewItem}" DisplayMemberPath="Title"
                                 MouseDoubleClick="OnNewItemDoubleClick" ItemContainerStyle="{StaticResource CompactRow}" Background="Transparent" BorderThickness="0" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- The menu Windows builds, with the user's changes marked, and the editor for one item -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Current menu" Style="{StaticResource SectionTitle}" />
                        <Grid>
                            <TreeView ItemsSource="{Binding Items}" SelectedItemChanged="OnItemSelected" Background="Transparent" BorderThickness="0">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <Grid>
                                            <Border x:Name="Line" Height="1" Width="180" HorizontalAlignment="Left" Opacity="0.3" Visibility="Collapsed"
                                                    Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" />
                                            <StackPanel x:Name="Row" Orientation="Horizontal" ToolTip="{Binding SeenOn}">
                                                <TextBlock x:Name="Title" Text="{Binding Title}" />
                                                <TextBlock Text="{Binding Note}" Margin="10,0,0,0" Opacity="0.6" FontStyle="Italic" />
                                            </StackPanel>
                                        </Grid>
                                        <HierarchicalDataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="Row" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                <Setter TargetName="Title" Property="TextDecorations" Value="Strikethrough" />
                                                <Setter TargetName="Title" Property="Opacity" Value="0.5" />
                                            </DataTrigger>
                                        </HierarchicalDataTemplate.Triggers>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                            <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <Grid>
                        <StackPanel Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Selected item" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Select an item in the current menu to hide, rename or move it."
                                       Style="{StaticResource Secondary}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding SelectedItem.OriginalTitle}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="Reset" Command="{Binding ResetCommand}" Padding="12,4" ToolTip="Undo every change to this item" />
                                <CheckBox DockPanel.Dock="Right" Content="Hide" IsChecked="{Binding SelectedItem.IsHidden}" Margin="0,0,16,0" VerticalAlignment="Center" />
                            </DockPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12" IsEnabled="{Binding SelectedItem.IsShown}">
                                <TextBlock Text="Rename" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding SelectedItem.NewTitle, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12" IsEnabled="{Binding SelectedItem.IsShown}">
                                <TextBlock Text="Move to submenu" Style="{StaticResource FieldLabel}" />
                                <ComboBox IsEditable="True" ItemsSource="{Binding Groups}" DropDownClosed="OnGroupPicked"
                                          Text="{Binding SelectedItem.Group, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" IsEnabled="{Binding SelectedItem.IsShown}">
                                <TextBlock Text="Position" Style="{StaticResource FieldLabel}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="▼" Command="{Binding MoveDownCommand}" ToolTip="Move down one row"
                                            AutomationProperties.Name="Move down" Padding="10,4" Margin="4,0,0,0" />
                                    <Button DockPanel.Dock="Right" Content="▲" Command="{Binding MoveUpCommand}" ToolTip="Move up one row"
                                            AutomationProperties.Name="Move up" Padding="10,4" Margin="8,0,0,0" />
                                    <ComboBox ItemsSource="{Binding PlacementOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedItem.Placement}" />
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Applies to" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ScopeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedItem.Scope}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- The result -->
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Preview" Style="{StaticResource SectionTitle}" />
                    <TreeView ItemsSource="{Binding Preview}" Focusable="False" Background="Transparent" BorderThickness="0">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Grid>
                                    <Border x:Name="Line" Height="1" Width="180" HorizontalAlignment="Left" Opacity="0.3" Visibility="Collapsed"
                                            Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" />
                                    <TextBlock x:Name="Title" Text="{Binding Title}" />
                                </Grid>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                        <Setter TargetName="Line" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="3" Margin="2,12,2,0">
            <TextBlock DockPanel.Dock="Right" Margin="24,0,0,0" ToolTip="Support the development of RCConfigurator">
                <Hyperlink NavigateUri="https://buymeacoffee.com/djjc13" RequestNavigate="OnOpenLink" TextDecorations="None">
                    <Run FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Text="&#xEC32;" BaselineAlignment="Center" />
                    <Run Text=" Buy me a coffee" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Text="{Binding Status}" Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
