<Window x:Class="RCConfigurator.App.GroupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My groups of file types" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap" Opacity="0.75"
                   Text="A group lets you edit the menus of several file types at once. The ready-made groups, such as Images and Code, are always available; make your own here." />

        <ListBox x:Name="GroupList" Height="130" Margin="0,12,0,0" DisplayMemberPath="Label" SelectionChanged="OnGroupSelected" />

        <TextBlock Text="Group name" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NameBox" />

        <TextBlock Text="File types in it" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="TypesBox" />
        <TextBlock Text="Separate them with spaces, for example: .psd .ai .xcf" Opacity="0.6" FontSize="12" Margin="0,4,0,0" />

        <TextBlock x:Name="ProblemText" Foreground="#E5484D" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

        <DockPanel Margin="0,20,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Add or update" Click="OnAddOrUpdate" Padding="14,6" />
            <Button x:Name="RemoveButton" DockPanel.Dock="Left" Content="Remove" Click="OnRemove" Padding="14,6" Margin="8,0,0,0" IsEnabled="False" />
            <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Padding="16,6" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Done" Click="OnDone" Padding="20,6" />
        </DockPanel>
    </StackPanel>
</Window>
