<Window x:Class="RCConfigurator.App.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registry clean-up" Width="760" Height="560" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="24">
        <TextBlock DockPanel.Dock="Top" Text="Remove obsolete registry entries" FontSize="20" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,16"
                   Text="The entries below remain in the Windows registry, but the program each one runs is no longer installed. Removing them deletes them permanently and releases the file types that still referred to the missing program. A backup is saved first, so the most recent clean-up can be restored." />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" LastChildFill="False">
            <Button x:Name="RemoveButton" DockPanel.Dock="Left" Content="Remove selected" Click="OnRemove" Padding="20,6" />
            <Button x:Name="UndoButton" DockPanel.Dock="Left" Content="Restore last backup" Click="OnUndo" Padding="14,6" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Padding="20,6" />
        </DockPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,12,0,0" MinHeight="20" />

        <ListBox x:Name="ProgramList" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,6">
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}" Opacity="0.75" TextWrapping="Wrap" />
                        </StackPanel>
                    </CheckBox>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
